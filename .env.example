# Gemini is opt-in. Leave it disabled to use the fully local pandas router.
# If you enable it, use only a newly created key and never commit .env.
ENABLE_GEMINI=false
NLP_CONFIDENCE_THRESHOLD=0.45
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
